# Copiá este archivo como .env en el servidor y completá los valores reales.
# NUNCA subas el .env real (con contraseñas de verdad) a git.

NODE_ENV=production

# Cadena de conexión a la base de datos RDS Postgres.
# Formato: postgresql://usuario:contraseña@endpoint-de-rds:5432/farmrapp
DATABASE_URL="postgresql://farmrapp:CAMBIAR_ESTA_CLAVE@tu-endpoint.rds.amazonaws.com:5432/farmrapp"

# Clave secreta para firmar las sesiones de login. Generá una nueva con:
#   openssl rand -base64 32
SESSION_SECRET="CAMBIAR_ESTA_CLAVE"
